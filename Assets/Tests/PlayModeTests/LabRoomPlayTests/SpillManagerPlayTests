using NUnit.Framework;
using UnityEngine;
using TMPro;
using System.Reflection;

public class SpillManagerPlayTests
{
    /*
     * Test:
     * verifies that cleaning the final spill:
     * - activates the game over panel
     * - marks the room as completed
     * - updates the score text
     */
    [Test]
    public void FinalSpillTriggersGameOver()
    {
        //create SpillManager object
        GameObject managerObj = new GameObject();
        SpillManager manager = managerObj.AddComponent<SpillManager>();

        //create fake game over panel
        manager.gameOverPanel = new GameObject();
        manager.gameOverPanel.SetActive(false);

        //create fake TMP text object
        GameObject textObj = new GameObject();
        manager.scoreText = textObj.AddComponent<TextMeshProUGUI>();

        //reset globals before test
        Global.currentRoomCompleted = false;

        //set a fake score
        Global.totalScore = 100;

        //manually set spillsRemaining = 1
        FieldInfo spillField = typeof(SpillManager).GetField(
            "spillsRemaining",
            BindingFlags.NonPublic | BindingFlags.Instance
        );

        spillField.SetValue(manager, 1);

        //manually set awarded = false
        FieldInfo awardedField = typeof(SpillManager).GetField(
            "awarded",
            BindingFlags.NonPublic | BindingFlags.Instance
        );

        awardedField.SetValue(manager, false);

        //simulate cleaning the last spill
        manager.OnSpillCleaned();

        //check that panel became active
        Assert.IsTrue(manager.gameOverPanel.activeSelf);

        //check that room completion updated
        Assert.IsTrue(Global.currentRoomCompleted);

        //check score text updated correctly
        Assert.AreEqual(
            "Total score: " + Global.totalScore,
            manager.scoreText.text
        );

        //cleanup
        Object.DestroyImmediate(managerObj);
        Object.DestroyImmediate(textObj);
    }


    /*
     * Test:
     * verifies that once awarded is true,
     * additional spill clean calls do nothing
     */
    [Test]
    public void SpillCleanDoesNothingAfterAwarded()
    {
        //create SpillManager object
        GameObject managerObj = new GameObject();
        SpillManager manager = managerObj.AddComponent<SpillManager>();

        //fake panel
        manager.gameOverPanel = new GameObject();
        manager.gameOverPanel.SetActive(false);

        //manually set awarded = true
        FieldInfo awardedField = typeof(SpillManager).GetField(
            "awarded",
            BindingFlags.NonPublic | BindingFlags.Instance
        );

        awardedField.SetValue(manager, true);

        //call spill cleaned
        manager.OnSpillCleaned();

        //panel should still remain inactive
        Assert.IsFalse(manager.gameOverPanel.activeSelf);

        //cleanup
        Object.DestroyImmediate(managerObj);
    }
}